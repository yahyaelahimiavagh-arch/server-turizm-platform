{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.serverturizm.com.tr/stti/contracts/STTI-TOUR-IMPORT-1.0.0.schema.json",
  "title": "Server Turizm Tour Intelligence — Tour Import Contract 1.0.0",
  "description": "External authoring/import contract for partial or structurally-full tour data. It is intentionally separate from canonical STTI-TOUR-1.1.0 and cannot request public publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_contract",
    "mode",
    "policy",
    "target",
    "sources",
    "tour"
  ],
  "properties": {
    "import_contract": {
      "const": "STTI-TOUR-IMPORT-1.0.0"
    },
    "mode": {
      "enum": [
        "partial",
        "full"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "missing_values",
        "publication"
      ],
      "properties": {
        "facts": {
          "const": "source_only_no_invention"
        },
        "missing_values": {
          "const": "omit_or_null_or_explicit_unknown"
        },
        "publication": {
          "const": "force_private"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "manual",
            "excel",
            "google_sheet",
            "ai",
            "system"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "expected_checksum_sha256"
      ],
      "properties": {
        "stable_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^STT-[0-9]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_checksum_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stable_id": {
                "type": "string"
              }
            },
            "required": [
              "stable_id"
            ]
          },
          "then": {
            "properties": {
              "expected_checksum_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stable_id": {
                "type": "null"
              }
            },
            "required": [
              "stable_id"
            ]
          },
          "then": {
            "properties": {
              "expected_checksum_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "tour": {
      "$ref": "#/$defs/tour"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "type",
        "ref",
        "completeness"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[A-Za-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "manual",
            "brochure",
            "google_sheet",
            "excel",
            "legacy_wordpress",
            "json_import",
            "website",
            "pdf",
            "image",
            "email",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "enum": [
            "source_complete",
            "source_partial",
            "source_minimal"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
