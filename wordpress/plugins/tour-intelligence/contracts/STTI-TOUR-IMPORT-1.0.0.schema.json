      "properties": {
        "primary_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "primary_city": {
          "type": [
            "string",
            "null"
          ]
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
