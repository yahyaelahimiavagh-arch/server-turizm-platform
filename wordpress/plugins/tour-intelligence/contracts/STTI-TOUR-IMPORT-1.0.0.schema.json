    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "month_only",
            "tentative",
            "coming_soon",
            "on_request",
            "undated"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "day_month_only",
            "month_only",
            "season_only",
            "unknown"
          ]
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "month": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration_nights": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "exact"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "start_date",
              "end_date"
            ],
            "properties": {
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "end_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "route_stop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "default": "stop"
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "city": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "city"
          ]
        },
        {
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ]
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route_stop"
          }
        }
      }
    },
    "itinerary_day": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day_number": {
