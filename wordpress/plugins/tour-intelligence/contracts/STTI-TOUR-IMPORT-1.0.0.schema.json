            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "hotel_relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "hotel_intelligence",
            "unresolved"
          ]
        },
        "hotel_stable_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "check_in": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_out": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "nights": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC-[A-Za-z0-9_-]+$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "hotel_intelligence"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "hotel_stable_id"
            ],
            "properties": {
              "hotel_stable_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "unresolved"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "unresolved_name"
            ],
            "properties": {
              "unresolved_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "transport_segment": {
